# Copy this file to .env.local and fill in your values. .env.local is ignored by git.

# Open Library API (public, no key). Must be HTTPS.
VITE_OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Supabase project (Project Settings -> API). The anon key is public by design:
# Row Level Security in supabase/schema.sql protects the data.
# Without these two values the app still works, but sign-in and loans show a setup notice.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
